---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import IndiaMap from '../components/IndiaMap.astro';

const features = [
  {
    title: 'Find Exam Centers',
    description: 'Locate your exam center on our interactive India map with detailed information and directions.',
    icon: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z',
    color: 'primary',
  },
  {
    title: 'Book Hotels',
    description: 'Get verified hotels near your exam center with real reviews and best price guarantee.',
    icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
    color: 'secondary',
  },
  {
    title: 'Plan Your Stay',
    description: 'Discover nearby food options, calculate travel time, and plan the perfect exam day.',
    icon: 'M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7',
    color: 'tertiary',
  },
  {
    title: '24/7 Support',
    description: 'Round-the-clock assistance for any exam-related queries or emergencies.',
    icon: 'M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z',
    color: 'primary',
  },
];

const testimonials = [
  {
    name: 'Amit Sharma',
    location: 'Delhi NCR',
    exam: 'JEE Main 2026',
    rating: 5,
    comment: 'CenterBuddy helped me find the perfect hotel near my exam center. Everything was so well organized!',
    image: 'https://picsum.photos/seed/amit/800/600',
  },
  {
    name: 'Priya Patel',
    location: 'Kota, Rajasthan',
    exam: 'NEET 2026',
    rating: 5,
    comment: 'The map feature is amazing! Found my center easily and even discovered great food places nearby.',
    image: 'https://picsum.photos/seed/priya/800/600',
  },
  {
    name: 'Rahul Verma',
    location: 'Bangalore',
    exam: 'KCET 2026',
    rating: 5,
    comment: 'Best platform for exam logistics. Saved me so much stress before my big exam day!',
    image: 'https://picsum.photos/seed/rahul/800/600',
  },
];

const stats = [
  { value: '50+', label: 'Cities Covered' },
  { value: '500+', label: 'Exam Centers' },
  { value: '10K+', label: 'Happy Students' },
  { value: '4.9', label: 'Average Rating' },
];
---

<Layout title="Home">
  <Navbar />

  <main class="pt-16">
    <section class="relative min-h-[90vh] flex items-center overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-br from-background via-surface-container-low to-background dark:from-dark-background dark:via-dark-surface-container-low dark:to-dark-background"></div>
      <div class="absolute top-20 left-10 w-72 h-72 bg-primary/10 rounded-full blur-3xl"></div>
      <div class="absolute bottom-20 right-10 w-96 h-96 bg-tertiary/10 rounded-full blur-3xl"></div>

      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div class="space-y-8">
            <div class="inline-flex items-center px-4 py-2 rounded-full bg-primary-fixed/20 dark:bg-primary-fixed/10 text-primary dark:text-inverse-primary text-sm font-medium">
              <span class="w-2 h-2 bg-primary dark:bg-inverse-primary rounded-full mr-2 animate-pulse"></span>
              India's #1 Exam Logistics Platform
            </div>

            <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold leading-tight">
              <span class="text-gradient">Ace Your Exams</span>
              <br />
              <span class="text-on-surface dark:text-dark-on-surface">Stress-Free</span>
            </h1>

            <p class="text-xl text-on-surface-variant dark:text-dark-on-surface-variant max-w-xl">
              Find your exam center, discover nearby hotels, explore food options, and plan your perfect exam day with CenterBuddy.
            </p>

            <div class="flex flex-col sm:flex-row gap-4">
              <a href="/centers" class="btn-primary text-lg px-8 py-4">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                </svg>
                Find Centers
              </a>
              <a href="/dashboard" class="btn-secondary text-lg px-8 py-4">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />
                </svg>
                View Dashboard
              </a>
            </div>

            <div class="flex items-center gap-8 pt-4">
              {stats.map((stat) => (
                <div class="text-center">
                  <div class="text-2xl md:text-3xl font-bold text-primary dark:text-inverse-primary">{stat.value}</div>
                  <div class="text-sm text-on-surface-variant dark:text-dark-on-surface-variant">{stat.label}</div>
                </div>
              ))}
            </div>
          </div>

          <div class="relative">
            <div class="map-container rounded-3xl overflow-hidden shadow-2xl">
              <IndiaMap height="500px" />
            </div>
            <div class="absolute -bottom-6 -left-6 glass-card p-4 rounded-2xl shadow-xl">
              <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-secondary-container flex items-center justify-center">
                  <svg class="w-6 h-6 text-on-secondary-container" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-on-surface dark:text-dark-on-surface">12 Cities</p>
                  <p class="text-sm text-on-surface-variant dark:text-dark-on-surface-variant">Exam centers live</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="features" class="py-24 bg-surface-container-low dark:bg-dark-surface-container-low">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-4xl md:text-5xl font-bold text-on-surface dark:text-dark-on-surface mb-6">
            Everything You Need for
            <span class="text-gradient">Exam Success</span>
          </h2>
          <p class="text-lg text-on-surface-variant dark:text-dark-on-surface-variant">
            From finding your center to booking your stay, we've got you covered with a complete exam logistics solution.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
          {features.map((feature) => (
            <div class="feature-card group">
              <div class={`w-14 h-14 rounded-2xl bg-${
                feature.color === 'primary' ? 'primary-container' :
                feature.color === 'secondary' ? 'secondary-container' : 'tertiary-container'
              } flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300`}>
                <svg class={`w-7 h-7 text-${
                  feature.color === 'primary' ? 'on-primary-container' :
                  feature.color === 'secondary' ? 'on-secondary-container' : 'on-tertiary-container'
                }`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={feature.icon} />
                </svg>
              </div>
              <h3 class="text-xl font-bold text-on-surface dark:text-dark-on-surface mb-3">{feature.title}</h3>
              <p class="text-on-surface-variant dark:text-dark-on-surface-variant">{feature.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="about" class="py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div class="relative">
            <img
              src="https://picsum.photos/seed/exam/800/600"
              alt="Students at exam center"
              class="rounded-3xl shadow-2xl w-full object-cover"
            />
            <div class="absolute -bottom-8 -right-8 glass-card p-6 rounded-2xl shadow-xl max-w-xs">
              <div class="flex items-center gap-4 mb-4">
                <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-secondary to-secondary-container flex items-center justify-center">
                  <svg class="w-6 h-6 text-on-secondary-container" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                  </svg>
                </div>
                <div>
                  <p class="font-bold text-on-surface dark:text-dark-on-surface">10,000+</p>
                  <p class="text-sm text-on-surface-variant dark:text-dark-on-surface-variant">Students Served</p>
                </div>
              </div>
              <div class="flex items-center gap-1">
                {[1, 2, 3, 4, 5].map((star) => (
                  <svg class="w-5 h-5 text-secondary" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
            </div>
          </div>

          <div class="space-y-8">
            <h2 class="text-4xl md:text-5xl font-bold text-on-surface dark:text-dark-on-surface">
              Why Students
              <span class="text-gradient">Trust Us</span>
            </h2>

            <div class="space-y-6">
              <div class="flex gap-4">
                <div class="w-12 h-12 rounded-xl bg-primary-container flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-on-primary-container" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-on-surface dark:text-dark-on-surface mb-1">Verified Information</h3>
                  <p class="text-on-surface-variant dark:text-dark-on-surface-variant">All centers and hotels are personally verified by our team for quality assurance.</p>
                </div>
              </div>

              <div class="flex gap-4">
                <div class="w-12 h-12 rounded-xl bg-secondary-container flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-on-secondary-container" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-on-surface dark:text-dark-on-surface mb-1">Real-Time Updates</h3>
                  <p class="text-on-surface-variant dark:text-dark-on-surface-variant">Get instant notifications about center changes, weather alerts, and traffic updates.</p>
                </div>
              </div>

              <div class="flex gap-4">
                <div class="w-12 h-12 rounded-xl bg-tertiary-container flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-on-tertiary-container" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" />
                  </svg>
                </div>
                <div>
                  <h3 class="text-lg font-semibold text-on-surface dark:text-dark-on-surface mb-1">24/7 Expert Support</h3>
                  <p class="text-on-surface-variant dark:text-dark-on-surface-variant">Our exam experts are available round the clock to help you with any queries.</p>
                </div>
              </div>
            </div>

            <a href="/dashboard" class="btn-primary inline-flex items-center gap-2">
              Get Started Free
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 bg-surface-container-low dark:bg-dark-surface-container-low">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-4xl md:text-5xl font-bold text-on-surface dark:text-dark-on-surface mb-6">
            What Students
            <span class="text-gradient">Say About Us</span>
          </h2>
          <p class="text-lg text-on-surface-variant dark:text-dark-on-surface-variant">
            Real stories from real students who trusted CenterBuddy for their exam journey.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          {testimonials.map((testimonial) => (
            <div class="testimonial-card">
              <div class="flex items-center gap-1 mb-4">
                {[1, 2, 3, 4, 5].map((star) => (
                  <svg class="w-5 h-5 text-secondary" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
              <p class="text-on-surface-variant dark:text-dark-on-surface-variant mb-6 text-lg">"{testimonial.comment}"</p>
              <div class="flex items-center gap-4">
                <img
                  src={testimonial.image}
                  alt={testimonial.name}
                  class="w-14 h-14 rounded-xl object-cover"
                />
                <div>
                  <p class="font-semibold text-on-surface dark:text-dark-on-surface">{testimonial.name}</p>
                  <p class="text-sm text-on-surface-variant dark:text-dark-on-surface-variant">{testimonial.exam} · {testimonial.location}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="glass-card rounded-3xl p-8 md:p-12 text-center">
          <h2 class="text-4xl md:text-5xl font-bold text-on-surface dark:text-dark-on-surface mb-6">
            Ready to
            <span class="text-gradient">Get Started?</span>
          </h2>
          <p class="text-lg text-on-surface-variant dark:text-dark-on-surface-variant max-w-2xl mx-auto mb-8">
            Join thousands of students who have already discovered the easiest way to prepare for their exams.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/dashboard" class="btn-primary text-lg px-10 py-4">
              Go to Dashboard
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a href="/centers" class="btn-outline text-lg px-10 py-4">
              Browse Centers
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>