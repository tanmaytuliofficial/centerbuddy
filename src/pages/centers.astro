---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import IndiaMap from '../components/IndiaMap.astro';
import { examCenters } from '../data/centers';
---

<Layout title="My Centers">
  <Navbar />

  <main class="pt-16 min-h-screen bg-background dark:bg-dark-background">
    <div class="flex flex-col lg:flex-row h-[calc(100vh-4rem)]">
      <div class="lg:w-96 bg-surface-container-low dark:bg-dark-surface-container-low border-r border-outline-variant dark:border-dark-outline-variant overflow-y-auto">
        <div class="p-6 border-b border-outline-variant dark:border-dark-outline-variant sticky top-0 bg-surface-container-low dark:bg-dark-surface-container-low z-10">
          <h1 class="text-2xl font-bold text-on-surface dark:text-dark-on-surface mb-4">Exam Centers</h1>
          <div class="relative">
            <input
              type="text"
              id="searchInput"
              placeholder="Search centers..."
              class="input-field pl-10"
            />
            <svg class="w-5 h-5 text-on-surface-variant absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
        </div>

        <div class="p-4 space-y-4" id="centerList">
          {examCenters.map((center) => (
            <div
              class="center-card card-hover glass-card rounded-2xl p-4 cursor-pointer"
              data-center-id={center.id}
            >
              <div class="flex gap-4">
                <img
                  src={center.image}
                  alt={center.name}
                  class="w-24 h-24 rounded-xl object-cover flex-shrink-0"
                />
                <div class="flex-1 min-w-0">
                  <h3 class="font-semibold text-on-surface dark:text-dark-on-surface truncate">{center.name}</h3>
                  <p class="text-sm text-on-surface-variant dark:text-dark-on-surface-variant">{center.city}</p>
                  <div class="flex items-center gap-2 mt-1">
                    <span class="flex items-center gap-1 text-secondary text-sm">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                      {center.rating}
                    </span>
                    <span class="text-xs text-on-surface-variant dark:text-dark-on-surface-variant">({center.reviewCount})</span>
                  </div>
                  <div class="flex items-center gap-2 mt-2">
                    <span class={`text-xs px-2 py-1 rounded-full ${
                      center.type === 'school' ? 'bg-tertiary-container text-on-tertiary-container' :
                      center.type === 'college' ? 'bg-secondary-container text-on-secondary-container' :
                      'bg-primary-container text-on-primary-container'
                    }`}>
                      {center.type.replace('_', ' ')}
                    </span>
                  </div>
                </div>
              </div>
              <div class="mt-3 pt-3 border-t border-outline-variant dark:border-dark-outline-variant">
                <p class="text-xs text-on-surface-variant dark:text-dark-on-surface-variant mb-2">{center.address}, {center.pincode}</p>
                <div class="flex flex-wrap gap-1">
                  {center.facilities.slice(0, 3).map((facility) => (
                    <span class="text-xs px-2 py-0.5 rounded-full bg-surface-container-high dark:bg-dark-surface-container-high text-on-surface-variant dark:text-dark-on-surface-variant">
                      {facility}
                    </span>
                  ))}
                  {center.facilities.length > 3 && (
                    <span class="text-xs px-2 py-0.5 rounded-full bg-surface-container-high dark:bg-dark-surface-container-high text-on-surface-variant dark:text-dark-on-surface-variant">
                      +{center.facilities.length - 3} more
                    </span>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="flex-1 relative">
        <div class="absolute inset-0 map-container rounded-none">
          <IndiaMap centers={examCenters} height="100%" />
        </div>

        <div class="absolute bottom-6 left-6 glass-card p-4 rounded-2xl shadow-xl z-10">
          <p class="text-sm text-on-surface-variant dark:text-dark-on-surface-variant mb-2">Click markers to see details</p>
          <div class="flex items-center gap-4">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-primary"></div>
              <span class="text-xs text-on-surface-variant dark:text-dark-on-surface-variant">College</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-secondary"></div>
              <span class="text-xs text-on-surface-variant dark:text-dark-on-surface-variant">School</span>
            </div>
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-tertiary"></div>
              <span class="text-xs text-on-surface-variant dark:text-dark-on-surface-variant">Community</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  const centerList = document.getElementById('centerList');
  const centerCards = document.querySelectorAll('.center-card');

  searchInput?.addEventListener('input', (e) => {
    const searchTerm = (e.target as HTMLInputElement).value.toLowerCase();

    centerCards.forEach((card) => {
      const centerId = card.getAttribute('data-center-id');
      const cardContent = card.textContent?.toLowerCase() || '';

      if (cardContent.includes(searchTerm) || searchTerm === '') {
        (card as HTMLElement).style.display = 'block';
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });
  });

  centerCards.forEach((card) => {
    card.addEventListener('click', () => {
      centerCards.forEach((c) => c.classList.remove('ring-2', 'ring-primary'));
      card.classList.add('ring-2', 'ring-primary');
    });
  });
</script>