---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
---

<Layout title="Admin Dashboard">
  <Navbar />

  <main class="pt-24 pb-12 min-h-screen bg-gray-50 dark:bg-dark-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-8">
        <h1 class="text-3xl md:text-4xl font-bold font-display text-gray-900 dark:text-white mb-2">
          Admin Dashboard
        </h1>
        <p class="text-gray-600 dark:text-gray-400">Manage centers, hotels, and reviews</p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        {[
          { title: 'Total Centers', value: '20', change: '+3', color: 'from-blue-500 to-blue-700', icon: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z' },
          { title: 'Active Hotels', value: '10', change: '+2', color: 'from-green-500 to-green-700', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5' },
          { title: 'Total Reviews', value: '156', change: '+12', color: 'from-purple-500 to-purple-700', icon: 'M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z' },
          { title: 'Students Served', value: '2,450', change: '+180', color: 'from-orange-500 to-orange-700', icon: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z' },
        ].map((stat) => (
          <div class="glass-card p-6">
            <div class="flex items-center justify-between mb-4">
              <div class={`w-12 h-12 rounded-xl bg-gradient-to-br ${stat.color} flex items-center justify-center shadow-lg`}>
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={stat.icon} />
                </svg>
              </div>
              <span class="text-green-500 text-sm font-medium">{stat.change}</span>
            </div>
            <div class="text-3xl font-bold text-gray-900 dark:text-white mb-1">{stat.value}</div>
            <div class="text-gray-500 dark:text-gray-400 text-sm">{stat.title}</div>
          </div>
        ))}
      </div>

      <div class="grid lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2">
          <div class="glass-card p-6 mb-6">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Quick Actions</h2>
            <div class="grid md:grid-cols-3 gap-4">
              <a href="/admin/centers" class="p-6 rounded-xl bg-gradient-to-br from-blue-50 to-blue-100 dark:from-blue-900/20 dark:to-blue-800/20 border border-blue-200 dark:border-blue-800 hover:scale-105 transition-transform">
                <svg class="w-8 h-8 text-blue-600 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                </svg>
                <div class="font-bold text-gray-900 dark:text-white">Manage Centers</div>
                <div class="text-sm text-gray-500 dark:text-gray-400">Add, edit or remove exam centers</div>
              </a>

              <a href="/admin/hotels" class="p-6 rounded-xl bg-gradient-to-br from-green-50 to-green-100 dark:from-green-900/20 dark:to-green-800/20 border border-green-200 dark:border-green-800 hover:scale-105 transition-transform">
                <svg class="w-8 h-8 text-green-600 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
                <div class="font-bold text-gray-900 dark:text-white">Manage Hotels</div>
                <div class="text-sm text-gray-500 dark:text-gray-400">Add, edit or remove hotels</div>
              </a>

              <a href="/admin/reviews" class="p-6 rounded-xl bg-gradient-to-br from-purple-50 to-purple-100 dark:from-purple-900/20 dark:to-purple-800/20 border border-purple-200 dark:border-purple-800 hover:scale-105 transition-transform">
                <svg class="w-8 h-8 text-purple-600 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                </svg>
                <div class="font-bold text-gray-900 dark:text-white">Manage Reviews</div>
                <div class="text-sm text-gray-500 dark:text-gray-400">Moderate user reviews</div>
              </a>
            </div>
          </div>

          <div class="glass-card p-6">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Recent Activity</h2>
            <div class="space-y-4">
              {[
                { action: 'New center added', item: 'IIT Bombay Center', time: '2 hours ago', type: 'center' },
                { action: 'Review approved', item: 'Great experience at Allen...', time: '4 hours ago', type: 'review' },
                { action: 'Hotel updated', item: 'Hotel Pearl Palace pricing', time: '6 hours ago', type: 'hotel' },
                { action: 'New booking', item: 'Student from Delhi booked Hotel...', time: '8 hours ago', type: 'booking' },
              ].map((activity) => (
                <div class="flex items-center space-x-4 p-3 rounded-xl hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
                  <div class={`w-10 h-10 rounded-xl flex items-center justify-center ${
                    activity.type === 'center' ? 'bg-blue-100 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400' :
                    activity.type === 'review' ? 'bg-purple-100 text-purple-600 dark:bg-purple-900/30 dark:text-purple-400' :
                    activity.type === 'hotel' ? 'bg-green-100 text-green-600 dark:bg-green-900/30 dark:text-green-400' :
                    'bg-orange-100 text-orange-600 dark:bg-orange-900/30 dark:text-orange-400'
                  }`}>
                    {activity.type === 'center' && (
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /></svg>
                    )}
                    {activity.type === 'review' && (
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" /></svg>
                    )}
                    {activity.type === 'hotel' && (
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5" /></svg>
                    )}
                    {activity.type === 'booking' && (
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
                    )}
                  </div>
                  <div class="flex-1">
                    <div class="font-medium text-gray-900 dark:text-white">{activity.action}</div>
                    <div class="text-sm text-gray-500 dark:text-gray-400">{activity.item}</div>
                  </div>
                  <div class="text-xs text-gray-400">{activity.time}</div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div>
          <div class="glass-card p-6 mb-6">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">System Status</h2>
            <div class="space-y-4">
              {[
                { name: 'API Server', status: 'Operational', color: 'green' },
                { name: 'Database', status: 'Operational', color: 'green' },
                { name: 'Map Service', status: 'Operational', color: 'green' },
                { name: 'Payment Gateway', status: 'Operational', color: 'green' },
              ].map((service) => (
                <div class="flex items-center justify-between">
                  <span class="text-gray-700 dark:text-gray-300">{service.name}</span>
                  <span class={`flex items-center space-x-1 text-${service.color}-600 dark:text-${service.color}-400`}>
                    <span class="w-2 h-2 rounded-full bg-${service.color}-500 animate-pulse"></span>
                    <span class="text-sm">{service.status}</span>
                  </span>
                </div>
              ))}
            </div>
          </div>

          <div class="glass-card p-6">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Popular Cities</h2>
            <div class="space-y-3">
              {[
                { city: 'Delhi NCR', count: 45 },
                { city: 'Mumbai', count: 38 },
                { city: 'Kota', count: 22 },
                { city: 'Bangalore', count: 32 },
                { city: 'Hyderabad', count: 29 },
              ].map((item, i) => (
                <div class="flex items-center space-x-3">
                  <span class="w-6 h-6 rounded-full bg-[var(--color-primary)]/10 text-[var(--color-primary)] text-xs font-bold flex items-center justify-center">{i + 1}</span>
                  <span class="flex-1 text-gray-700 dark:text-gray-300">{item.city}</span>
                  <span class="text-gray-500 dark:text-gray-400 text-sm">{item.count} centers</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>