---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { examCenters } from '../../data/centers';
import { hotels } from '../../data/hotels';
import { reviews } from '../../data/centers';

const stats = [
  { label: 'Total Centers', value: examCenters.length.toString(), icon: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z', color: 'primary' },
  { label: 'Hotels', value: hotels.length.toString(), icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4', color: 'secondary' },
  { label: 'Reviews', value: reviews.length.toString(), icon: 'M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z', color: 'tertiary' },
  { label: 'Active Users', value: '1,234', icon: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z', color: 'primary' },
];

const tabs = [
  { id: 'centers', label: 'Centers', active: true },
  { id: 'hotels', label: 'Hotels', active: false },
  { id: 'reviews', label: 'Reviews', active: false },
];
---

<Layout title="Admin Dashboard">
  <Navbar />

  <main class="pt-16 min-h-screen bg-background dark:bg-dark-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-on-surface dark:text-dark-on-surface">Admin Dashboard</h1>
        <p class="text-on-surface-variant dark:text-dark-on-surface-variant">Manage your exam center ecosystem</p>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        {stats.map((stat) => (
          <div class="stat-card">
            <div class={`w-12 h-12 rounded-xl bg-${stat.color}-container flex items-center justify-center mb-4`}>
              <svg class={`w-6 h-6 text-on-${stat.color}-container`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={stat.icon} />
              </svg>
            </div>
            <div class="text-3xl font-bold text-on-surface dark:text-dark-on-surface mb-1">{stat.value}</div>
            <div class="text-sm text-on-surface-variant dark:text-dark-on-surface-variant">{stat.label}</div>
          </div>
        ))}
      </div>

      <div class="glass-card rounded-3xl overflow-hidden">
        <div class="flex border-b border-outline-variant dark:border-dark-outline-variant">
          {tabs.map((tab) => (
            <button
              class={`tab-btn px-6 py-4 font-medium transition-colors ${
                tab.active
                  ? 'text-primary dark:text-inverse-primary border-b-2 border-primary'
                  : 'text-on-surface-variant dark:text-dark-on-surface-variant hover:text-on-surface dark:hover:text-dark-on-surface'
              }`}
              data-tab={tab.id}
            >
              {tab.label}
            </button>
          ))}
        </div>

        <div id="centers-tab" class="tab-content p-6">
          <div class="flex justify-between items-center mb-6">
            <h3 class="text-lg font-semibold text-on-surface dark:text-dark-on-surface">Exam Centers</h3>
            <button class="btn-primary">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              Add Center
            </button>
          </div>

          <div class="overflow-x-auto">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>City</th>
                  <th>Type</th>
                  <th>Rating</th>
                  <th>Reviews</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                {examCenters.slice(0, 10).map((center) => (
                  <tr>
                    <td>
                      <div class="flex items-center gap-3">
                        <img src={center.image} alt={center.name} class="w-10 h-10 rounded-lg object-cover" />
                        <div>
                          <p class="font-medium text-on-surface dark:text-dark-on-surface">{center.name}</p>
                          <p class="text-xs text-on-surface-variant dark:text-dark-on-surface-variant">{center.address}</p>
                        </div>
                      </div>
                    </td>
                    <td class="text-on-surface-variant dark:text-dark-on-surface-variant">{center.city}</td>
                    <td>
                      <span class={`text-xs px-2 py-1 rounded-full ${
                        center.type === 'school' ? 'bg-tertiary-container text-on-tertiary-container' :
                        center.type === 'college' ? 'bg-secondary-container text-on-secondary-container' :
                        'bg-primary-container text-on-primary-container'
                      }`}>
                        {center.type.replace('_', ' ')}
                      </span>
                    </td>
                    <td class="flex items-center gap-1">
                      <svg class="w-4 h-4 text-secondary" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                      <span class="text-on-surface dark:text-dark-on-surface">{center.rating}</span>
                    </td>
                    <td class="text-on-surface-variant dark:text-dark-on-surface-variant">{center.reviewCount}</td>
                    <td>
                      <div class="flex items-center gap-2">
                        <button class="p-2 rounded-lg hover:bg-surface-container-high dark:hover:bg-dark-surface-container-high transition-colors">
                          <svg class="w-4 h-4 text-on-surface-variant dark:text-dark-on-surface-variant" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                          </svg>
                        </button>
                        <button class="p-2 rounded-lg hover:bg-error-container transition-colors">
                          <svg class="w-4 h-4 text-error" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div id="hotels-tab" class="tab-content p-6 hidden">
          <div class="flex justify-between items-center mb-6">
            <h3 class="text-lg font-semibold text-on-surface dark:text-dark-on-surface">Hotels</h3>
            <button class="btn-primary">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              Add Hotel
            </button>
          </div>

          <div class="overflow-x-auto">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Name</th>
                  <th>City</th>
                  <th>Price</th>
                  <th>Rating</th>
                  <th>Reviews</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                {hotels.slice(0, 10).map((hotel) => (
                  <tr>
                    <td>
                      <div class="flex items-center gap-3">
                        <img src={hotel.image} alt={hotel.name} class="w-10 h-10 rounded-lg object-cover" />
                        <span class="font-medium text-on-surface dark:text-dark-on-surface">{hotel.name}</span>
                      </div>
                    </td>
                    <td class="text-on-surface-variant dark:text-dark-on-surface-variant">{hotel.city}</td>
                    <td class="text-on-surface dark:text-dark-on-surface font-medium">₹{hotel.price}</td>
                    <td class="flex items-center gap-1">
                      <svg class="w-4 h-4 text-secondary" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                      <span class="text-on-surface dark:text-dark-on-surface">{hotel.rating}</span>
                    </td>
                    <td class="text-on-surface-variant dark:text-dark-on-surface-variant">{hotel.reviewCount}</td>
                    <td>
                      <div class="flex items-center gap-2">
                        <button class="p-2 rounded-lg hover:bg-surface-container-high dark:hover:bg-dark-surface-container-high transition-colors">
                          <svg class="w-4 h-4 text-on-surface-variant dark:text-dark-on-surface-variant" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                          </svg>
                        </button>
                        <button class="p-2 rounded-lg hover:bg-error-container transition-colors">
                          <svg class="w-4 h-4 text-error" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                          </svg>
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div id="reviews-tab" class="tab-content p-6 hidden">
          <div class="flex justify-between items-center mb-6">
            <h3 class="text-lg font-semibold text-on-surface dark:text-dark-on-surface">Reviews</h3>
            <button class="btn-primary">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              Add Review
            </button>
          </div>

          <div class="overflow-x-auto">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Author</th>
                  <th>Center</th>
                  <th>Rating</th>
                  <th>Comment</th>
                  <th>Date</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                {reviews.map((review) => {
                  const center = examCenters.find(c => c.id === review.centerId);
                  return (
                    <tr>
                      <td class="font-medium text-on-surface dark:text-dark-on-surface">{review.author}</td>
                      <td class="text-on-surface-variant dark:text-dark-on-surface-variant">{center?.name || 'N/A'}</td>
                      <td class="flex items-center gap-1">
                        {[1, 2, 3, 4, 5].map((star) => (
                          <svg class={`w-4 h-4 ${star <= review.rating ? 'text-secondary' : 'text-outline-variant'}`} fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                          </svg>
                        ))}
                      </td>
                      <td class="text-on-surface-variant dark:text-dark-on-surface-variant max-w-xs truncate">{review.comment}</td>
                      <td class="text-on-surface-variant dark:text-dark-on-surface-variant">{review.date}</td>
                      <td>
                        <div class="flex items-center gap-2">
                          <button class="p-2 rounded-lg hover:bg-surface-container-high dark:hover:bg-dark-surface-container-high transition-colors">
                            <svg class="w-4 h-4 text-on-surface-variant dark:text-dark-on-surface-variant" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                            </svg>
                          </button>
                          <button class="p-2 rounded-lg hover:bg-error-container transition-colors">
                            <svg class="w-4 h-4 text-error" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                          </button>
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  const tabBtns = document.querySelectorAll('.tab-btn');
  const tabContents = document.querySelectorAll('.tab-content');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tabId = btn.getAttribute('data-tab');

      tabBtns.forEach((b) => {
        b.classList.remove('text-primary', 'dark:text-inverse-primary', 'border-b-2', 'border-primary');
        b.classList.add('text-on-surface-variant', 'dark:text-dark-on-surface-variant');
      });

      btn.classList.add('text-primary', 'dark:text-inverse-primary', 'border-b-2', 'border-primary');
      btn.classList.remove('text-on-surface-variant', 'dark:text-dark-on-surface-variant');

      tabContents.forEach((content) => {
        (content as HTMLElement).classList.add('hidden');
      });

      const activeContent = document.getElementById(`${tabId}-tab`);
      if (activeContent) {
        activeContent.classList.remove('hidden');
      }
    });
  });
</script>