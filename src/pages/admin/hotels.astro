---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import { hotels } from '../../../data/data';
---

<Layout title="Manage Hotels - Admin">
  <Navbar />

  <main class="pt-24 pb-12 min-h-screen bg-gray-50 dark:bg-dark-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h1 class="text-3xl font-bold font-display text-gray-900 dark:text-white">Manage Hotels</h1>
          <p class="text-gray-600 dark:text-gray-400">Add, edit or remove hotel partnerships</p>
        </div>
        <button class="btn-primary flex items-center space-x-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
          </svg>
          <span>Add Hotel</span>
        </button>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {hotels.map((hotel) => (
          <div class="glass-card overflow-hidden card-hover">
            <div class="relative">
              <img src={hotel.image} alt={hotel.name} class="w-full h-40 object-cover" loading="lazy" />
              <div class="absolute top-4 right-4">
                <span class="px-3 py-1 rounded-full bg-white/90 dark:bg-gray-900/90 text-sm font-bold text-[var(--color-primary)]">
                  ₹{hotel.price.toLocaleString()}/night
                </span>
              </div>
            </div>

            <div class="p-5">
              <div class="flex items-start justify-between mb-2">
                <h3 class="font-bold text-gray-900 dark:text-white">{hotel.name}</h3>
                <span class="px-2 py-0.5 rounded-full bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400 text-xs">Active</span>
              </div>
              <p class="text-sm text-gray-500 dark:text-gray-400 mb-3">{hotel.city}</p>

              <div class="flex items-center space-x-3 mb-4 text-sm">
                <span class="text-yellow-500">★ {hotel.rating}</span>
                <span class="text-gray-300 dark:text-gray-600">|</span>
                <span class="text-gray-500 dark:text-gray-400">{hotel.reviewCount} reviews</span>
                <span class="text-gray-300 dark:text-gray-600">|</span>
                <span class="text-gray-500 dark:text-gray-400">{hotel.distance}</span>
              </div>

              <div class="flex flex-wrap gap-2 mb-4">
                {hotel.amenities.slice(0, 3).map((amenity) => (
                  <span class="px-2 py-1 rounded-md bg-gray-100 dark:bg-gray-800 text-xs text-gray-600 dark:text-gray-400">
                    {amenity}
                  </span>
                ))}
              </div>

              <div class="flex items-center space-x-2 pt-4 border-t border-gray-100 dark:border-gray-800">
                <button class="flex-1 btn-primary text-sm py-2">Edit</button>
                <button class="px-3 py-2 rounded-xl border-2 border-red-200 dark:border-red-800 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/30 transition-colors text-sm">
                  Delete
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>
</Layout>