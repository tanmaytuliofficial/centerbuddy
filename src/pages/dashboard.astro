---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { exams, examCenters, hotels, foodPlaces, cities } from '../../data/data';

const upcomingExam = exams[1];
const primaryCenter = examCenters.find(c => c.id === upcomingExam.primaryCenter);
const backupCenter = examCenters.find(c => c.id === upcomingExam.backupCenter);
const nearbyHotels = hotels.filter(h => h.city === upcomingExam.city).slice(0, 3);
const nearbyFood = foodPlaces.slice(0, 4);

function getTimeRemaining(date: string) {
  const examDate = new Date(date);
  const now = new Date();
  const diff = examDate.getTime() - now.getTime();
  const days = Math.floor(diff / (1000 * 60 * 60 * 24));
  const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
  return { days, hours };
}

const timeRemaining = getTimeRemaining(upcomingExam.date);
---

<Layout title="Student Dashboard">
  <Navbar />

  <main class="pt-24 pb-12 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-8">
        <h1 class="text-3xl md:text-4xl font-bold font-display text-gray-900 dark:text-white mb-2">
          Welcome back, Student! 👋
        </h1>
        <p class="text-gray-600 dark:text-gray-400">Here's your exam journey overview</p>
      </div>

      <div class="grid lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-6">
          <div class="glass-card p-6">
            <div class="flex items-center justify-between mb-6">
              <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Upcoming Exam</h2>
              <span class="px-4 py-2 rounded-full bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400 text-sm font-medium">
                Admit Card Available ✓
              </span>
            </div>

            <div class="flex flex-col md:flex-row md:items-center gap-6 mb-8">
              <div class="flex-1">
                <h3 class="text-2xl font-bold text-[var(--color-primary)] mb-2">{upcomingExam.name}</h3>
                <div class="flex flex-wrap items-center gap-4 text-gray-600 dark:text-gray-400">
                  <span class="flex items-center space-x-1">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span>{new Date(upcomingExam.date).toLocaleDateString('en-IN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}</span>
                  </span>
                  <span class="flex items-center space-x-1">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>{upcomingExam.time}</span>
                  </span>
                  <span class="flex items-center space-x-1">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    </svg>
                    <span>{upcomingExam.city}</span>
                  </span>
                </div>
              </div>

              <div class="flex items-center space-x-3">
                <div class="countdown-box">
                  <div class="text-3xl font-bold text-white">{timeRemaining.days}</div>
                  <div class="text-xs text-white/80">Days</div>
                </div>
                <div class="countdown-box">
                  <div class="text-3xl font-bold text-white">{timeRemaining.hours}</div>
                  <div class="text-xs text-white/80">Hours</div>
                </div>
              </div>
            </div>

            <div class="grid md:grid-cols-2 gap-4">
              <div class="p-4 rounded-xl bg-gradient-to-br from-[var(--color-primary)]/10 to-[var(--color-tertiary)]/10 border border-[var(--color-primary)]/20">
                <div class="flex items-center space-x-2 mb-3">
                  <span class="px-2 py-1 rounded-lg bg-[var(--color-primary)] text-white text-xs font-medium">Primary</span>
                  <span class="text-sm text-gray-500">Your assigned center</span>
                </div>
                <h4 class="font-bold text-gray-900 dark:text-white mb-1">{primaryCenter?.name}</h4>
                <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">{primaryCenter?.address}</p>
                <div class="flex items-center space-x-2">
                  <span class="text-yellow-500">★</span>
                  <span class="text-sm font-medium">{primaryCenter?.rating} ({primaryCenter?.reviewCount} reviews)</span>
                </div>
              </div>

              <div class="p-4 rounded-xl bg-gradient-to-br from-[var(--color-secondary)]/10 to-orange-500/10 border border-[var(--color-secondary)]/20">
                <div class="flex items-center space-x-2 mb-3">
                  <span class="px-2 py-1 rounded-lg bg-[var(--color-secondary)] text-white text-xs font-medium">Backup</span>
                  <span class="text-sm text-gray-500">Alternate center</span>
                </div>
                <h4 class="font-bold text-gray-900 dark:text-white mb-1">{backupCenter?.name}</h4>
                <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">{backupCenter?.address}</p>
                <div class="flex items-center space-x-2">
                  <span class="text-yellow-500">★</span>
                  <span class="text-sm font-medium">{backupCenter?.rating} ({backupCenter?.reviewCount} reviews)</span>
                </div>
              </div>
            </div>

            <div class="mt-6 flex flex-wrap gap-3">
              <a href={`/centers?id=${primaryCenter?.id}`} class="btn-primary flex items-center space-x-2 text-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                </svg>
                <span>View on Map</span>
              </a>
              <button class="px-4 py-2 rounded-xl border-2 border-[var(--color-primary)] text-[var(--color-primary)] font-semibold hover:bg-[var(--color-primary)] hover:text-white transition-colors text-sm">
                Download Admit Card
              </button>
            </div>
          </div>

          <div class="glass-card p-6">
            <div class="flex items-center justify-between mb-6">
              <h2 class="text-xl font-bold text-gray-900 dark:text-white">Nearby Food Places</h2>
              <a href="/stay" class="text-sm text-[var(--color-primary)] font-medium hover:underline">View All</a>
            </div>

            <div class="grid grid-cols-2 gap-4">
              {nearbyFood.map((place) => (
                <div class="p-4 rounded-xl bg-gradient-to-br from-green-50 to-green-100 dark:from-green-900/20 dark:to-green-800/20 border border-green-200 dark:border-green-800">
                  <div class="flex items-center space-x-3 mb-3">
                    <img src={place.image} alt={place.name} class="w-12 h-12 rounded-xl object-cover" loading="lazy" />
                    <div>
                      <h4 class="font-semibold text-gray-900 dark:text-white text-sm">{place.name}</h4>
                      <span class={`text-xs px-2 py-0.5 rounded-full ${
                        place.type === 'veg' ? 'bg-green-500/20 text-green-700 dark:text-green-400' :
                        place.type === 'nonveg' ? 'bg-red-500/20 text-red-700 dark:text-red-400' :
                        'bg-yellow-500/20 text-yellow-700 dark:text-yellow-400'
                      }`}>
                        {place.type.toUpperCase()}
                      </span>
                    </div>
                  </div>
                  <div class="flex items-center justify-between text-sm">
                    <span class="text-gray-500 dark:text-gray-400">{place.distance}</span>
                    <span class="text-yellow-500">★ {place.rating}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="space-y-6">
          <div class="glass-card p-6">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-6">Nearby Hotels</h2>

            <div class="space-y-4">
              {nearbyHotels.map((hotel) => (
                <div class="flex space-x-4 p-3 rounded-xl hover:bg-white/50 dark:hover:bg-white/5 transition-colors">
                  <img src={hotel.image} alt={hotel.name} class="w-20 h-20 rounded-xl object-cover flex-shrink-0" loading="lazy" />
                  <div class="flex-1 min-w-0">
                    <h4 class="font-semibold text-gray-900 dark:text-white truncate">{hotel.name}</h4>
                    <p class="text-sm text-gray-500 dark:text-gray-400">{hotel.distance} from center</p>
                    <div class="flex items-center space-x-2 mt-1">
                      <span class="text-yellow-500 text-sm">★ {hotel.rating}</span>
                      <span class="text-[var(--color-primary)] font-bold">₹{hotel.price.toLocaleString()}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>

            <a href="/stay" class="mt-6 w-full btn-primary flex items-center justify-center space-x-2 text-sm">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
              <span>Book a Stay</span>
            </a>
          </div>

          <div class="glass-card p-6">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Live Status</h2>

            <div class="space-y-4">
              <div class="flex items-center justify-between p-3 rounded-xl bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800">
                <div class="flex items-center space-x-3">
                  <div class="w-3 h-3 rounded-full bg-green-500 animate-pulse"></div>
                  <span class="font-medium text-gray-900 dark:text-white">Traffic</span>
                </div>
                <span class="text-green-600 dark:text-green-400 font-semibold">Clear</span>
              </div>

              <div class="flex items-center justify-between p-3 rounded-xl bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800">
                <div class="flex items-center space-x-3">
                  <div class="w-3 h-3 rounded-full bg-blue-500 animate-pulse"></div>
                  <span class="font-medium text-gray-900 dark:text-white">Weather</span>
                </div>
                <span class="text-blue-600 dark:text-blue-400 font-semibold">24°C Sunny</span>
              </div>

              <div class="flex items-center justify-between p-3 rounded-xl bg-purple-50 dark:bg-purple-900/20 border border-purple-200 dark:border-purple-800">
                <div class="flex items-center space-x-3">
                  <div class="w-3 h-3 rounded-full bg-purple-500 animate-pulse"></div>
                  <span class="font-medium text-gray-900 dark:text-white">Support</span>
                </div>
                <span class="text-purple-600 dark:text-purple-400 font-semibold">Online</span>
              </div>
            </div>
          </div>

          <div class="glass-card p-6">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Quick Actions</h2>

            <div class="space-y-3">
              <a href="/centers" class="flex items-center space-x-3 p-3 rounded-xl hover:bg-white/50 dark:hover:bg-white/5 transition-colors group">
                <div class="w-10 h-10 rounded-xl bg-[var(--color-primary)]/10 flex items-center justify-center group-hover:bg-[var(--color-primary)] transition-colors">
                  <svg class="w-5 h-5 text-[var(--color-primary)] group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  </svg>
                </div>
                <span class="font-medium text-gray-900 dark:text-white">View All Centers</span>
              </a>

              <a href="/stay" class="flex items-center space-x-3 p-3 rounded-xl hover:bg-white/50 dark:hover:bg-white/5 transition-colors group">
                <div class="w-10 h-10 rounded-xl bg-[var(--color-secondary)]/10 flex items-center justify-center group-hover:bg-[var(--color-secondary)] transition-colors">
                  <svg class="w-5 h-5 text-[var(--color-secondary)] group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                </div>
                <span class="font-medium text-gray-900 dark:text-white">Book Hotel</span>
              </a>

              <a href="#" class="flex items-center space-x-3 p-3 rounded-xl hover:bg-white/50 dark:hover:bg-white/5 transition-colors group">
                <div class="w-10 h-10 rounded-xl bg-teal-500/10 flex items-center justify-center group-hover:bg-teal-500 transition-colors">
                  <svg class="w-5 h-5 text-teal-500 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <span class="font-medium text-gray-900 dark:text-white">Call Support</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>