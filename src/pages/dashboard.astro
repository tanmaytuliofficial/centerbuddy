---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import IndiaMap from '../components/IndiaMap.astro';
import { exams, foodPlaces } from '../data/exams';
import { hotels } from '../data/hotels';
import { examCenters } from '../data/centers';

const upcomingExam = exams[0];
const primaryCenter = examCenters.find(c => c.id === upcomingExam.primaryCenter);
const backupCenter = examCenters.find(c => c.id === upcomingExam.backupCenter);
const nearbyHotels = hotels.filter(h => h.city === upcomingExam.city).slice(0, 3);
const nearbyFood = foodPlaces.slice(0, 4);

function getTimeRemaining(targetDate: string) {
  const now = new Date();
  const target = new Date(targetDate);
  const diff = target.getTime() - now.getTime();

  const days = Math.floor(diff / (1000 * 60 * 60 * 24));
  const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));

  return { days, hours };
}

const timeRemaining = getTimeRemaining(upcomingExam.date);

const statusItems = [
  { label: 'Traffic', status: 'online', value: 'Clear' },
  { label: 'Weather', status: 'online', value: '23°C Clear' },
  { label: 'Support', status: 'online', value: '24/7 Active' },
];

const quickActions = [
  { label: 'View Admit Card', icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z', href: '#' },
  { label: 'Book Hotel', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4', href: '/stay' },
  { label: 'Find Food', icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253', href: '#' },
  { label: 'Get Directions', icon: 'M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7', href: '#' },
];
---

<Layout title="Dashboard">
  <Navbar />

  <main class="pt-16 min-h-screen bg-background dark:bg-dark-background">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-on-surface dark:text-dark-on-surface">Welcome back!</h1>
        <p class="text-on-surface-variant dark:text-dark-on-surface-variant">Here's your exam preparation dashboard</p>
      </div>

      <div class="grid lg:grid-cols-3 gap-8">
        <div class="lg:col-span-2 space-y-8">
          <div class="glass-card rounded-3xl p-6">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
              <div>
                <p class="text-sm text-on-surface-variant dark:text-dark-on-surface-variant mb-1">Next Exam</p>
                <h2 class="text-2xl font-bold text-on-surface dark:text-dark-on-surface">{upcomingExam.name}</h2>
                <p class="text-on-surface-variant dark:text-dark-on-surface-variant">{upcomingExam.date} · {upcomingExam.time}</p>
              </div>
              <div class="flex items-center gap-2">
                {upcomingExam.admitCardAvailable ? (
                  <span class="inline-flex items-center px-3 py-1 rounded-full bg-tertiary-container text-on-tertiary-container text-sm font-medium">
                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Admit Card Available
                  </span>
                ) : (
                  <span class="inline-flex items-center px-3 py-1 rounded-full bg-error-container text-on-error-container text-sm font-medium">
                    Admit Card Pending
                  </span>
                )}
              </div>
            </div>

            <div class="flex flex-wrap gap-4">
              <div class="countdown-box">
                <div class="text-3xl font-bold">{timeRemaining.days}</div>
                <div class="text-sm opacity-80">Days</div>
              </div>
              <div class="countdown-box">
                <div class="text-3xl font-bold">{timeRemaining.hours}</div>
                <div class="text-sm opacity-80">Hours</div>
              </div>
              <div class="flex-1 min-w-[200px] glass rounded-2xl p-4 flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-secondary-container flex items-center justify-center">
                  <svg class="w-6 h-6 text-on-secondary-container" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <p class="text-sm text-on-surface-variant dark:text-dark-on-surface-variant">Exam Date</p>
                  <p class="font-semibold text-on-surface dark:text-dark-on-surface">{upcomingExam.date}</p>
                </div>
              </div>
            </div>
          </div>

          <div class="grid md:grid-cols-2 gap-6">
            <div class="glass-card rounded-3xl p-6">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-xl bg-primary-container flex items-center justify-center">
                  <svg class="w-5 h-5 text-on-primary-container" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  </svg>
                </div>
                <h3 class="text-lg font-semibold text-on-surface dark:text-dark-on-surface">Primary Center</h3>
              </div>
              {primaryCenter && (
                <div class="space-y-3">
                  <img src={primaryCenter.image} alt={primaryCenter.name} class="w-full h-32 object-cover rounded-xl" />
                  <h4 class="font-semibold text-on-surface dark:text-dark-on-surface">{primaryCenter.name}</h4>
                  <p class="text-sm text-on-surface-variant dark:text-dark-on-surface-variant">{primaryCenter.address}</p>
                  <div class="flex items-center gap-4 text-sm">
                    <span class="flex items-center gap-1 text-secondary">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                      {primaryCenter.rating}
                    </span>
                    <span class="text-on-surface-variant dark:text-dark-on-surface-variant">{primaryCenter.reviewCount} reviews</span>
                  </div>
                </div>
              )}
            </div>

            <div class="glass-card rounded-3xl p-6">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-xl bg-tertiary-container flex items-center justify-center">
                  <svg class="w-5 h-5 text-on-tertiary-container" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5" />
                  </svg>
                </div>
                <h3 class="text-lg font-semibold text-on-surface dark:text-dark-on-surface">Backup Center</h3>
              </div>
              {backupCenter && (
                <div class="space-y-3">
                  <img src={backupCenter.image} alt={backupCenter.name} class="w-full h-32 object-cover rounded-xl" />
                  <h4 class="font-semibold text-on-surface dark:text-dark-on-surface">{backupCenter.name}</h4>
                  <p class="text-sm text-on-surface-variant dark:text-dark-on-surface-variant">{backupCenter.address}</p>
                  <div class="flex items-center gap-4 text-sm">
                    <span class="flex items-center gap-1 text-secondary">
                      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                      {backupCenter.rating}
                    </span>
                    <span class="text-on-surface-variant dark:text-dark-on-surface-variant">{backupCenter.reviewCount} reviews</span>
                  </div>
                </div>
              )}
            </div>
          </div>

          <div class="glass-card rounded-3xl p-6">
            <h3 class="text-lg font-semibold text-on-surface dark:text-dark-on-surface mb-4">Nearby Hotels</h3>
            <div class="grid md:grid-cols-3 gap-4">
              {nearbyHotels.map((hotel) => (
                <div class="card-hover rounded-2xl overflow-hidden border border-outline-variant dark:border-dark-outline-variant">
                  <img src={hotel.image} alt={hotel.name} class="w-full h-28 object-cover" />
                  <div class="p-4">
                    <h4 class="font-semibold text-on-surface dark:text-dark-on-surface text-sm truncate">{hotel.name}</h4>
                    <div class="flex items-center justify-between mt-2">
                      <span class="text-primary dark:text-inverse-primary font-bold">₹{hotel.price}</span>
                      <span class="text-xs text-on-surface-variant dark:text-dark-on-surface-variant">{hotel.distance}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
            <a href="/stay" class="inline-flex items-center gap-2 mt-4 text-primary dark:text-inverse-primary font-medium">
              View All Hotels
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>

          <div class="glass-card rounded-3xl p-6">
            <h3 class="text-lg font-semibold text-on-surface dark:text-dark-on-surface mb-4">Nearby Food Places</h3>
            <div class="grid md:grid-cols-2 gap-4">
              {nearbyFood.map((food) => (
                <div class="flex items-center gap-4 p-3 rounded-xl bg-surface-container-low dark:bg-dark-surface-container-low">
                  <img src={food.image} alt={food.name} class="w-16 h-16 rounded-xl object-cover" />
                  <div class="flex-1 min-w-0">
                    <h4 class="font-medium text-on-surface dark:text-dark-on-surface text-sm truncate">{food.name}</h4>
                    <p class="text-xs text-on-surface-variant dark:text-dark-on-surface-variant">{food.cuisines.join(', ')}</p>
                    <div class="flex items-center gap-3 mt-1">
                      <span class="text-xs text-secondary font-medium">{food.rating} ★</span>
                      <span class="text-xs text-on-surface-variant dark:text-dark-on-surface-variant">{food.distance}</span>
                      <span class={`text-xs px-2 py-0.5 rounded-full ${
                        food.type === 'veg' ? 'bg-tertiary-container text-on-tertiary-container' :
                        food.type === 'nonveg' ? 'bg-secondary-container text-on-secondary-container' :
                        'bg-primary-container text-on-primary-container'
                      }`}>
                        {food.type.toUpperCase()}
                      </span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <div class="space-y-6">
          <div class="glass-card rounded-3xl p-6">
            <h3 class="text-lg font-semibold text-on-surface dark:text-dark-on-surface mb-4">Quick Actions</h3>
            <div class="space-y-3">
              {quickActions.map((action) => (
                <a
                  href={action.href}
                  class="flex items-center gap-3 p-3 rounded-xl bg-surface-container-low dark:bg-dark-surface-container-low hover:bg-surface-container-high dark:hover:bg-dark-surface-container-high transition-colors"
                >
                  <div class="w-10 h-10 rounded-xl bg-primary-container flex items-center justify-center">
                    <svg class="w-5 h-5 text-on-primary-container" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={action.icon} />
                    </svg>
                  </div>
                  <span class="font-medium text-on-surface dark:text-dark-on-surface">{action.label}</span>
                </a>
              ))}
            </div>
          </div>

          <div class="glass-card rounded-3xl p-6">
            <h3 class="text-lg font-semibold text-on-surface dark:text-dark-on-surface mb-4">Live Status</h3>
            <div class="space-y-4">
              {statusItems.map((item) => (
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <div class={`status-indicator status-${item.status}`}></div>
                    <span class="text-on-surface-variant dark:text-dark-on-surface-variant">{item.label}</span>
                  </div>
                  <span class="text-sm font-medium text-on-surface dark:text-dark-on-surface">{item.value}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="glass-card rounded-3xl p-6">
            <h3 class="text-lg font-semibold text-on-surface dark:text-dark-on-surface mb-4">Your Location</h3>
            <div class="map-container rounded-2xl overflow-hidden" style="height: 200px;">
              <IndiaMap height="200px" showAllMarkers={false} selectedCity={upcomingExam.city} />
            </div>
          </div>

          <div class="glass-card rounded-3xl p-6">
            <h3 class="text-lg font-semibold text-on-surface dark:text-dark-on-surface mb-4">Emergency Contacts</h3>
            <div class="space-y-3">
              <div class="p-3 rounded-xl bg-error-container/20 border border-error-container">
                <p class="text-sm font-medium text-error">Medical Emergency</p>
                <p class="text-lg font-bold text-error">108</p>
              </div>
              <div class="p-3 rounded-xl bg-surface-container-high dark:bg-dark-surface-container-high">
                <p class="text-sm text-on-surface-variant dark:text-dark-on-surface-variant">Exam Support</p>
                <p class="font-bold text-on-surface dark:text-dark-on-surface">1800-XXX-YYYY</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>