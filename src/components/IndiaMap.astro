---
import { cities } from '../data/data';

interface Props {
  centers?: { name: string; lat: number; lng: number; city: string }[];
  selectedCity?: string;
  height?: string;
  showAllMarkers?: boolean;
}

const {
  centers = [],
  selectedCity = '',
  height = '400px',
  showAllMarkers = true
} = Astro.props;

const mapCities = showAllMarkers ? cities : cities.filter(c => c.city === selectedCity);
---

<div class="map-container" style={`height: ${height}`}>
  <div id="map" class="w-full h-full"></div>
</div>

<script define:vars={{ mapCities, selectedCity }}>
  import('maplibre-gl').then((maplibregl) => {
    const map = new maplibregl.Map({
      container: 'map',
      style: {
        version: 8,
        sources: {
          'osm': {
            type: 'raster',
            tiles: [
              'https://a.tile.openstreetmap.org/{z}/{x}/{y}.png',
              'https://b.tile.openstreetmap.org/{z}/{x}/{y}.png',
              'https://c.tile.openstreetmap.org/{z}/{x}/{y}.png'
            ],
            tileSize: 256,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
          }
        },
        layers: [
          {
            id: 'osm',
            type: 'raster',
            source: 'osm',
            minzoom: 0,
            maxzoom: 19
          }
        ]
      },
      center: [78.9629, 20.5937],
      zoom: 4.5,
      minZoom: 3,
      maxZoom: 15
    });

    map.addControl(new maplibregl.NavigationControl(), 'top-right');

    map.on('load', () => {
      mapCities.forEach((city) => {
        const el = document.createElement('div');
        el.className = 'marker-pin';
        el.style.backgroundColor = selectedCity === city.name ? '#004655' : '#845400';
        el.style.width = '32px';
        el.style.height = '32px';
        el.innerHTML = `<span class="marker-label">${city.name.split(' ')[0]}</span>`;

        const popup = new maplibregl.Popup({
          offset: 25,
          closeButton: true,
          closeOnClick: false
        }).setHTML(`
          <div class="p-2">
            <h3 class="font-semibold text-lg text-on-surface dark:text-dark-on-surface">${city.name}</h3>
            <p class="text-sm text-on-surface-variant dark:text-dark-on-surface-variant">${city.state}</p>
            <p class="text-sm text-primary dark:text-inverse-primary font-medium">${city.centerCount} Centers</p>
          </div>
        `);

        new maplibregl.Marker(el)
          .setLngLat([city.lng, city.lat])
          .setPopup(popup)
          .addTo(map);
      });

      centers.forEach((center) => {
        const el = document.createElement('div');
        el.className = 'marker-pin';
        el.style.backgroundColor = '#004655';
        el.style.width = '28px';
        el.style.height = '28px';

        const popup = new maplibregl.Popup({
          offset: 25,
          closeButton: true,
          closeOnClick: false
        }).setHTML(`
          <div class="p-2">
            <h3 class="font-semibold text-lg text-on-surface dark:text-dark-on-surface">${center.name}</h3>
            <p class="text-sm text-on-surface-variant dark:text-dark-on-surface-variant">${center.city}</p>
            <a href="/centers" class="text-sm text-primary dark:text-inverse-primary font-medium hover:underline">View Details →</a>
          </div>
        `);

        new maplibregl.Marker(el)
          .setLngLat([center.lng, center.lat])
          .setPopup(popup)
          .addTo(map);
      });
    });

    const darkModeObserver = new MutationObserver((mutations) => {
      mutations.forEach((mutation) => {
        if (mutation.attributeName === 'class') {
          const isDark = document.documentElement.classList.contains('dark');
          const canvas = document.querySelector('#map canvas');
          if (canvas) {
            canvas.style.filter = isDark ? 'brightness(0.85) contrast(1.1)' : 'none';
          }
        }
      });
    });

    darkModeObserver.observe(document.documentElement, { attributes: true });
  });
</script>