---
interface Props {
  title: string;
  subtitle?: string;
  icon?: string;
  gradient?: boolean;
}

const { title, subtitle, icon, gradient = true } = Astro.props;
---

<div class:list={[
  'text-center mb-16',
  gradient && 'relative'
]}>
  {gradient && (
    <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-[var(--color-primary)]/10 rounded-full blur-3xl"></div>
  )}
  {icon && (
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-[var(--color-primary)] to-[var(--color-tertiary)] text-white mb-6 shadow-lg">
      <Fragment set:html={icon} />
    </div>
  )}
  <h2 class="text-4xl md:text-5xl font-bold font-display text-gray-900 dark:text-white mb-4">
    {title}
  </h2>
  {subtitle && (
    <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
      {subtitle}
    </p>
  )}
</div>